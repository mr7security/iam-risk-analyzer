# IAM Risk Analyzer — plantilla de configuración
# Copia este archivo a ".env" y rellena los valores.
#   cp .env.example .env
#
# El .env real NUNCA debe subirse al repositorio (está en .gitignore).

# Método de autenticación: device_code | client_secret | certificate
AZURE_AUTH_METHOD=device_code

# Identificadores del tenant y de la app (App Registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Solo para client_secret
AZURE_CLIENT_SECRET=

# Solo para certificate (PFX o PEM)
AZURE_CERT_PATH=
AZURE_CERT_PASSWORD=
