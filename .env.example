# IAM Risk Analyzer — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Auth method: client_secret | certificate | device_code
AZURE_AUTH_METHOD=device_code

# Required for all methods
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-app-registration-client-id-here

# Required for client_secret method
AZURE_CLIENT_SECRET=your-client-secret-here

# Required for certificate method
AZURE_CERT_PATH=./certs/my-cert.pfx
AZURE_CERT_PASSWORD=optional-pfx-password
